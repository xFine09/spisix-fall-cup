# Copia este archivo como .env y rellénalo. No lo subas nunca a GitHub ni lo compartas.

# Dirección pública de la web, sin barra final: la que da Tailscale Funnel.
# El "Application Callback URL" de osu! debe ser exactamente BASE_URL + /auth/osu/callback
BASE_URL=https://NOMBRE.TAILNET.ts.net

# Credenciales de la aplicación OAuth de osu! (osu.ppy.sh → Ajustes de cuenta → OAuth → Nueva aplicación OAuth)
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# IDs de osu! de los hosts, separados por comas (el número de la URL de su perfil).
# Tienen acceso a la pestaña Admin y asignan los roles (admin, árbitro, staff) desde la web.
# Tras cambiarlo: docker compose up -d
ADMIN_IDS=

# Twitch (opcional): para saber cuándo hay directo en el canal de config.json ("twitch") y mostrar el aviso
# y la ventana con el directo. dev.twitch.tv/console/apps → Register Your Application (hace falta tener
# activada la verificación en dos pasos en Twitch). OAuth Redirect URL: http://localhost (no se usa),
# Category: Website Integration, Client Type: Confidential. Copia el Client ID y pulsa New Secret.
# Puede registrarla cualquier cuenta de Twitch: no hace falta la del canal.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
